# secrets and local configuration
# .env matches the file itself; .env.* catches .env.production and friends;
# *.env catches production.env. only the examples are ever committed
.env
.env.*
*.env
!.env.example
!*.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
key.properties

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# dart and flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
coverage/
*.iml
# generated from the arb files; never committed
gradus_feature/lib/src/l10n/generated/

# only the application lockfile is committed; libraries resolve through it
app_ui/pubspec.lock
gradus_feature/pubspec.lock

# tooling and os
.idea/
.vscode/
.claude/
.DS_Store
*.log
