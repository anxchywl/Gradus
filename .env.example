# environment - authoritative; every development guard keys on this, never on
# a log level or a debug flag. omitting it means production
APP_ENV=development

# authentication
# 'host' in staging and production. the host resolver verifies a host token
# when the HOST_JWT_* values below are set, and rejects every token when
# they are not - see docs/ARCHITECTURE.md
AUTH_ADAPTER=development

# host identity. the host issues the token; this service only verifies
# it. with no issuer and no key the host resolver rejects everything, which is
# the safe default. set the public key for RS*/ES*, or a shared secret of at
# least 32 bytes for HS*, never both
HOST_JWT_ISSUER=
HOST_JWT_AUDIENCE=
HOST_JWT_ALGORITHM=RS256
HOST_JWT_PUBLIC_KEY=
HOST_JWT_SECRET=
HOST_SUBJECT_CLAIM=sub
# operator access is granted only when this claim carries exactly this value;
# both are set together or neither is
HOST_OPERATOR_CLAIM=
HOST_OPERATOR_VALUE=

# development adapter only; refused at startup when APP_ENV=production.
# random values, supplied outside source control, and they must differ
DEVELOPMENT_AUTH_TOKEN=
DEVELOPMENT_AUTH_SUBJECT=student-a
DEVELOPMENT_OPERATOR_AUTH_TOKEN=
DEVELOPMENT_OPERATOR_AUTH_SUBJECT=operator-a

# syllabus extraction. with no key the endpoint refuses and the service still
# starts, so health stays answerable either way
SYLLABUS_API_KEY=
# anthropic | openai | gemini | deepseek. the last three speak the same wire
# protocol, so only the endpoint and the model id change between them.
# the default is free within google's rate limits rather than measured;
# backend/evals is what settles it if extraction quality disappoints
SYLLABUS_PROVIDER=gemini
SYLLABUS_MODEL=gemini-3.1-flash-lite
# only for an endpoint the provider profiles do not already know; must be https
SYLLABUS_BASE_URL=
SYLLABUS_TIMEOUT_SECONDS=45
SYLLABUS_OUTPUT_TOKENS=4000
SYLLABUS_DOCUMENT_MAX_BYTES=4194304
SYLLABUS_DOCUMENT_MAX_PAGES=60
SYLLABUS_DOCUMENT_MAX_CHARACTERS=120000
# per account, in one process; it fails closed when it cannot decide
SYLLABUS_RATE_LIMIT=20
SYLLABUS_RATE_WINDOW_SECONDS=3600

# api surface
CORS_ALLOWED_ORIGINS=
API_DOCS_ENABLED=false
REQUEST_BODY_MAX_BYTES=150000
DEFAULT_PAGE_SIZE=20
MAXIMUM_PAGE_SIZE=50

# flutter standalone host - build defines, not runtime variables.
# never passed to a build that leaves a development machine:
#   --dart-define=ENABLE_DEV_ACCESS=true
#   --dart-define=GRADUS_ACCESS_TOKEN=<same value as DEVELOPMENT_AUTH_TOKEN>
#   --dart-define=GRADUS_OPERATOR_ACCESS_TOKEN=<same as DEVELOPMENT_OPERATOR_AUTH_TOKEN>
